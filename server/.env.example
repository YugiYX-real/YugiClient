# Copy to /etc/halcyon-backend.env and edit before starting the service.

# Bind address. Keep it on loopback when nginx terminates tls in front of it.
# Set 0.0.0.0 to answer directly on the public ip.
HOST=127.0.0.1
PORT=8787

# Where the json state lives. The service user must be able to write here.
DATA_FILE=/var/lib/halcyon-backend/state.json

# Where website accounts and sessions live. Defaults to accounts.json beside DATA_FILE.
ACCOUNT_FILE=/var/lib/halcyon-backend/accounts.json

# Where launcher update artifacts are stored. Defaults to an updates folder beside DATA_FILE.
UPDATE_DIR=/var/lib/halcyon-backend/updates

# Where cape and cosmetic images are stored. Defaults to a cosmetics folder beside DATA_FILE.
COSMETIC_DIR=/var/lib/halcyon-backend/cosmetics

# The website files. Defaults to the public folder next to src, which is what install.sh copies.
PUBLIC_DIR=/opt/halcyon-backend/public

# Optional. Reserve one username so that account becomes an admin when it registers, no matter
# how many accounts already exist. Leave empty and the first account ever created is the admin.
ADMIN_USERNAME=

# Required for the branding, announcement, update and cosmetic write endpoints when they are
# called with curl. Signed in admins on the website do not need it.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional shared secret. When set, clients must send it as x-halcyon-key.
CLIENT_KEY=

# How long a player counts as online after a heartbeat.
PRESENCE_TTL_SECONDS=300

# How long an offline player is remembered before being forgotten.
RETENTION_DAYS=7
