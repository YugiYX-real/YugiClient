# Copy to /etc/halcyon-backend.env and edit before starting the service.

# Bind address. Keep it on loopback when nginx terminates tls in front of it.
HOST=127.0.0.1
PORT=8787

# Where the json state lives. The service user must be able to write here.
DATA_FILE=/var/lib/halcyon-backend/state.json

# Required for the branding and announcement endpoints. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Optional shared secret. When set, clients must send it as x-halcyon-key.
CLIENT_KEY=

# How long a player counts as online after a heartbeat.
PRESENCE_TTL_SECONDS=300

# How long an offline player is remembered before being forgotten.
RETENTION_DAYS=7
