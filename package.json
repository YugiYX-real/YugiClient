{
  "name": "halcyon",
  "version": "1.0.0",
  "private": true,
  "description": "Halcyon Launcher, a premium open source Minecraft launcher",
  "author": {
    "name": "jjbkl"
  },
  "license": "MIT",
  "homepage": "https://github.com/jjbkl/YugiClient",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjbkl/YugiClient.git"
  },
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "examples/plugins/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "npm run build && npm run assets:icons && electron-builder --publish never",
    "package:win": "npm run build && npm run assets:icons && electron-builder --win --publish never",
    "package:linux": "npm run build && npm run assets:icons && electron-builder --linux --publish never",
    "package:mac": "npm run build && npm run assets:icons && electron-builder --mac --publish never",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:icons": "node scripts/generate-icons.mjs",
    "version:inject": "node scripts/inject-version.mjs",
    "clean": "node scripts/clean.mjs",
    "verify": "npm run lint && npm run typecheck && npm test",
    "verify:strict": "npm run format:check && npm run verify"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "10.8.0",
    "png-to-ico": "^2.1.8",
    "prettier": "3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "^5.4.9"
  }
}
